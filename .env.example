# 複製此檔為 .env 並填入實際值

# 推理服務設定
MODEL_PATH=./models/ieee-qwen2.5-1.5b-lora
BASE_MODEL=Qwen/Qwen2.5-1.5B-Instruct
API_HOST=0.0.0.0
API_PORT=8000

# HuggingFace（下載模型用）
HF_TOKEN=your_huggingface_token_here

# 資料集路徑
DATA_DIR=./data
DATASET_OUTPUT=./data/training_pairs.jsonl

# 訓練設定
WANDB_PROJECT=ieee-slm
WANDB_API_KEY=your_wandb_key_here
